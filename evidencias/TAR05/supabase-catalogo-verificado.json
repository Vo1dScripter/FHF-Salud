  "constraints": [
    {
      "name": "appointment_events_appointment_id_fkey",
      "table": "appointment_events",
      "definition": "FOREIGN KEY (appointment_id) REFERENCES appointments(id) ON UPDATE RESTRICT ON DELETE RESTRICT"
    },
    {
      "name": "appointment_events_pkey",
      "table": "appointment_events",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "appointment_events_type_check",
      "table": "appointment_events",
      "definition": "CHECK ((event_type = ANY (ARRAY['created'::text, 'confirmed'::text, 'rescheduled'::text, 'cancelled'::text, 'updated'::text])))"
    },
    {
      "name": "appointments_cancellation_fields_check",
      "table": "appointments",
      "definition": "CHECK ((((status = 'cancelled'::text) AND (cancelled_at IS NOT NULL) AND (cancellation_reason IS NOT NULL) AND ((char_length(btrim(cancellation_reason)) >= 1) AND (char_length(btrim(cancellation_reason)) <= 500))) OR ((status <> 'cancelled'::text) AND (cancelled_at IS NULL) AND (cancelled_by IS NULL) AND (cancellation_reason IS NULL))))"
    },
    {
      "name": "appointments_duration_check",
      "table": "appointments",
      "definition": "CHECK ((duration_minutes = ANY (ARRAY[15, 30, 45, 60])))"
    },
    {
      "name": "appointments_ends_at_check",
      "table": "appointments",
      "definition": "CHECK ((ends_at > starts_at))"
    },
    {
      "name": "appointments_no_overlap",
      "table": "appointments",
      "definition": "EXCLUDE USING gist (physician_id WITH =, tstzrange(starts_at, ends_at, '[)'::text) WITH &&) WHERE ((status <> 'cancelled'::text))"
    },
    {
      "name": "appointments_patient_id_fkey",
      "table": "appointments",
      "definition": "FOREIGN KEY (patient_id) REFERENCES patients(id) ON UPDATE RESTRICT ON DELETE RESTRICT"
    },
    {
      "name": "appointments_physician_id_fkey",
      "table": "appointments",
      "definition": "FOREIGN KEY (physician_id) REFERENCES physicians(id) ON UPDATE RESTRICT ON DELETE RESTRICT"
    },
    {
      "name": "appointments_pkey",
      "table": "appointments",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "appointments_reason_check",
      "table": "appointments",
      "definition": "CHECK (((char_length(btrim(reason)) >= 1) AND (char_length(btrim(reason)) <= 500)))"
    },
    {
      "name": "appointments_status_check",
      "table": "appointments",
      "definition": "CHECK ((status = ANY (ARRAY['pending'::text, 'confirmed'::text, 'cancelled'::text])))"
    },
    {
      "name": "patients_display_name_check",
      "table": "patients",
      "definition": "CHECK (((char_length(btrim(display_name)) >= 1) AND (char_length(btrim(display_name)) <= 200)))"
    },
    {
