# !STARTERCONF Duplicate this to .env

# DEVELOPMENT TOOLS
# Ideally, don't add them to production deployment envs
# !STARTERCONF Change to true if you want to log data
NEXT_PUBLIC_SHOW_LOGGER="false"

# Python
PYTHONUTF8="1"
PYTHONDONTWRITEBYTECODE="1"

# Multimedia pipeline
MULTIMEDIA_SOURCE="recursos"
MULTIMEDIA_DEST="public"
MULTIMEDIA_ONLY=""
MULTIMEDIA_FORCE="false"
MULTIMEDIA_VERBOSE="true"

# Images
MULTIMEDIA_IMAGE_MAX_MB="1"
MULTIMEDIA_IMAGE_QUALITY_START="80"
MULTIMEDIA_IMAGE_QUALITY_MIN="50"
MULTIMEDIA_IMAGE_QUALITY_STEP="5"
MULTIMEDIA_WEBP_QUALITY="80"
MULTIMEDIA_AVIF_QUALITY="50"

# Video
MULTIMEDIA_VIDEO_WIDTH="1280"
MULTIMEDIA_VIDEO_CRF="24"
MULTIMEDIA_VIDEO_FPS="30"
MULTIMEDIA_WEBM_BITRATE="200k"
MULTIMEDIA_WEBM_CRF="35"
MULTIMEDIA_OGG_QUALITY="5"
MULTIMEDIA_GIF_WIDTH="480"
MULTIMEDIA_GIF_FPS="10"
MULTIMEDIA_GIF_SECONDS="3"

# Optional explicit inputs
MULTIMEDIA_OG_INPUT=""
MULTIMEDIA_OG_OUTPUT="og.jpg"
MULTIMEDIA_OG_WIDTH="1200"
MULTIMEDIA_OG_HEIGHT="630"
MULTIMEDIA_OG_QUALITY="85"
MULTIMEDIA_FAVICON_INPUT=""
MULTIMEDIA_FAVICON_NAME="Sitio"
MULTIMEDIA_FAVICON_SHORT_NAME="Sitio"
MULTIMEDIA_FAVICON_THEME_COLOR="#ffffff"
MULTIMEDIA_FAVICON_BACKGROUND_COLOR="#ffffff"
MULTIMEDIA_FAVICON_DISPLAY="standalone"

# Supabase: solo URL del proyecto y clave publica publicable.
# Copiar valores reales a .env.local (ignorado por Git) y Vercel.
# Nunca usar sb_secret_ ni service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
